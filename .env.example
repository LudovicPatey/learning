# Public URL of the site (used to build the ORCID redirect URI).
APP_URL=http://localhost:3000

# ORCID OAuth client. Register at https://orcid.org/developer-tools
# (or https://sandbox.orcid.org/developer-tools for testing).
# Redirect URI to register: ${APP_URL}/api/auth/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Use https://sandbox.orcid.org while testing.
ORCID_BASE_URL=https://orcid.org

# Comma-separated ORCID iDs allowed to resolve / moderate suggestions.
ADMIN_ORCIDS=

# SQLite file (default: data/app.db)
# DATABASE_PATH=
