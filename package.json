{
  "name": "computability-learning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check-content": "node --experimental-strip-types --no-warnings scripts/check-content.ts",
    "typecheck": "tsc --noEmit",
    "release": "node --experimental-strip-types --no-warnings scripts/release-course.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run check-content"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.6",
    "katex": "^0.16.47",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "mdast-util-directive": "^3.2.0",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
